# --- grok-search backend (required) ---
# Responses-compatible base URL + key. Same values grok-search reads.
GROK_API_URL=https://api.x.ai/v1
GROK_API_KEY=replace-me

# --- extra source providers (optional, improves source coverage) ---
# TAVILY_API_KEY=
# FIRECRAWL_API_URL=

# --- where grok-search skill lives on disk ---
# 留空则默认使用当前用户的 ~/.claude/skills/grok-search。
# 换机、CI 或生产环境建议显式配置。
# GROK_SEARCH_DIR=

# --- where the daily Markdown lands (Obsidian vault) ---
# 留空则根据当前用户 home 推导常见 iCloud Obsidian 路径。
# 换机、CI 或生产环境建议显式配置。
# OBSIDIAN_DIR=

# --- report tuning ---
# Restrict extra sources to the last N days (grok-search --days). 1 = 当日优先
# （2026-08-11 优化：默认收紧到 1，配合当日硬源与 recency 过滤保证"当日性"）。
GROK_DAYS=1
# 当日严格模式（默认 true）：报告头部标注素材窗口（当日 N 条 + 近几日 M 条 +
# 过期已过滤 K 条）；低素材日（当日硬源 < 10）给出显式提示。设 false 关闭标注。
# REPORT_STRICT_DAILY=true
# 可选：让搜索与综合用不同模型。设 GROK_SEARCH_MODEL 后，grok-search 搜索子进程
# 用它；综合写手仍用 GROK_MODEL（=SYNTH_MODEL）。不设则搜索/综合同模型（旧行为）。
# GROK_SEARCH_MODEL=deepseek-v4-pro

# --- 当日硬源（HN / 36kr / arXiv，零配置公开 API）---
# 2026-08-11 新增：当日素材保底。这些源按发布时间过滤（北京时间当日），确保
# linux.do 安静日（如 08-10 仅 1 帖）时模型仍有 ≥10 条当日素材可综合，降低
# 凭记忆补白/编造风险。每个源独立开关；单个失败自动降级为 0 条，不阻塞主流程。
# AGGREGATE_DAILY_SOURCE_LIMIT=15  # 当日硬源合并后总上限（默认 15）
# HN_DAILY_ENABLED=true            # Hacker News firebase API（当日 topstories，AI 相关过滤）
# HN_DAILY_LIMIT=12  # 合并 top+best(去重，batch 100)，默认 12 条
# KR36_DAILY_ENABLED=false         # 36kr.com/feed RSS（2026-08-11: 默认关闭——Firecrawl 拿到的 URL 被重写为 feed 首页，去重后合并为一条，待稳定方案）
# KR36_DAILY_LIMIT=5
# ARXIV_DAILY_ENABLED=true         # arXiv cs.AI API（当日新提交论文）
# ARXIV_DAILY_LIMIT=5  # arXiv 论文自动 2 天宽限(UTC 提交日在北京常落昨天/前天)
# OPENAI_DAILY_ENABLED=true          # OpenAI News RSS (openai.com/news/rss.xml，当日过滤)
# OPENAI_DAILY_LIMIT=4
# HF_DAILY_ENABLED=true             # Hugging Face Blog RSS (huggingface.co/blog/feed.xml，当日过滤)
# HF_DAILY_LIMIT=4
# GOOGLE_AI_DAILY_ENABLED=true      # Google AI Blog RSS (blog.google/technology/ai/rss)
# GOOGLE_AI_DAILY_LIMIT=4
# GOOGLE_RESEARCH_DAILY_ENABLED=true  # Google Research Blog RSS (research.google/blog/rss)
# GOOGLE_RESEARCH_DAILY_LIMIT=4
# How many Tavily/Firecrawl/Fathom sources to pull (grok-search --extra).
GROK_EXTRA=10
# Max chars to fetch from github.com/trending.
GROK_FETCH_MAX_CHARS=80000

# --- model + synthesis (llm-synthesize.mjs) ---
# GROK_MODEL = 综合写手模型（主频道 /chat/completions）。搜索模型可单独用
# GROK_SEARCH_MODEL 覆盖（见上）。gpt-5.6-luna 是默认主模型;可切换
# grok-4.5 / deepseek-v4-pro / gemini-3.6-flash。
GROK_MODEL=gpt-5.6-luna
# 主模型综合失败时自动回退一次的后备模型（默认 grok-4.5；仅作用于非 gemini 的单发综合路径）。
# 例：主模型 gpt-5.6-luna 在 cpa 网关常因 Cloudflare ~120s 上限 524，回退到 grok-4.5 保证出报。
# GROK_SYNTH_FALLBACK_MODEL=grok-4.5
# Synthesis tuning (optional; defaults shown):
# GROK_SYNTH_MAX_TOKENS=4000   # completion token cap; truncation is detected via finish_reason
# GROK_SYNTH_TIMEOUT_MS=90000  # wall-clock budget for the /chat/completions call
# GROK_SYNTH_TIMEOUT_MS=420000 # 主模型换成慢速推理模型（如 gpt-5.6-luna）时建议放宽
# GROK_CHILD_TIMEOUT_MS=120000 # wall-clock budget for each grok-search child process

# --- query templates ({date} is replaced with today's YYYY-MM-DD) ---
AI_QUERY=今天{date}最新的AI资讯和大模型动态

# --- 第二 AI 通道（完整双通道，ai-news.mjs + run.mjs）---
# 默认开启：与主 AI 通道并存，各自独立搜索+综合，写独立文件 <date>/AI-<slug>.md。
# 默认 gemini-3.6-flash（唯一支持 web_search 的模型，发查询词 → 客户端执行 → 回喂 → 收敛）。
# 写作模型经 /chat/completions 综合。其余模型（gpt-5.6-luna / deepseek-v4-pro / grok-4.5）单发。
# AI_ALT_CHANNEL=false  # 关闭后恢复单通道
# AI_ALT_MODEL=gemini-3.6-flash  # 默认 gemini-3.6-flash（唯一支持 web_search 的模型）；可选 gpt-5.6-luna / deepseek-v4-pro / grok-4.5
#                          # （deepseek-v4-pro 在部分供应商很慢/需人工预算，实测 ~74s；gemini 秒回）
# AI_ALT_QUERY=        # 留空复用 AI_QUERY
# AI_ALT_FILE=         # 输出文件名覆盖（如 AI-Luna.md）；默认 AI-<模型slug>.md
# AI_ALT_SYNTH_TIMEOUT_MS=300000  # alt 写作模型综合预算（deepseek 实测偏慢），默认 5 分钟
# AI_ALT_GEMINI_WEBSEARCH=true    # gemini 写作时启用客户端 web_search 工具循环（默认 true；改 false 走单发）
# AI_ALT_GEMINI_MAX_ROUNDS=2      # 工具检索轮数上限，防止搜索死循环，默认 2

# --- linux.do 论坛 AI 来源优先（ai-news.mjs + linuxdo.mjs）---
# 默认开启：额外抓取 前沿快讯 + 人工智能 tag，合并到综合来源最前面。
# LINUXDO_ENABLED=false
# 列表页，逗号分隔；默认 https://linux.do/c/news/34,https://linux.do/tag/444-tag/444
# LINUXDO_LIST_URLS=
# 最多纳入多少条 AI 相关帖（标题过滤后，HTML 列表路径），默认 8
# LINUXDO_TOPIC_LIMIT=8
# 是否深抓帖子正文做 snippet，默认 true；关掉则只用标题
# LINUXDO_DEEP_FETCH=true
# 深抓帖子数量上限（≤ TOPIC_LIMIT），默认 5
# LINUXDO_DEEP_FETCH_LIMIT=5
# 综合时总来源上限（社区优先占位后补通用来源），默认 18
# AI_SOURCE_MAX_TOTAL=18
# 用 Discourse JSON API 抓 前沿快讯(c/news/34)：不筛 AI、抓当日全部帖子（created_at 精确过滤），
# 供模型完整分析。默认 true；false 则退回原来的 HTML 列表 + AI 标题过滤路径。
# LINUXDO_NEWS34_JSON_API=true
# 可选：linux.do 登录态 cookie（原始 Cookie 头，如 _t=…;_u=…）。配置后 news/34 JSON
# 分页优先用 cookie 直连拉取（经真实 Chrome CDP 读取，见下），能稳定拉下第 2/3 页的
# 当天前沿快讯，避开 Tavily 快照限制。直连失败会自动回退 provider 栈，不会丢数据。
# LINUXDO_COOKIE=
# 登录态 Chrome 的 CDP 端点（需以 --remote-debugging-port=9222 启动）。cookie 直连通过
# 真实浏览器指纹绕过 Cloudflare cf_clearance 校验；留空则只做裸 undici 尝试（通常 403）。
# LINUXDO_CDP_HOST=127.0.0.1:9222
# linux.do 单独进入综合的来源上限（独立于 AI_SOURCE_MAX_TOTAL，社区+通用来源仍共享其预算），
# 默认 50 —— 让当日全部帖子都能喂给模型，而不会挤掉通用来源配额。设 0 回到单池旧行为。
# LINUXDO_MAX_SOURCES=50
# JSON API 全量路径下，深抓正文做 snippet 的帖子数上限（默认 40；覆盖当天几乎全部帖，使辅助资料
# 里每条都带真实抓取的正文。独立于 LINUXDO_TOPIC_LIMIT，后者只作用于 HTML 列表路径）。提高则
# 更多帖子有真实正文，降低则跑得更快。
# LINUXDO_NEWS34_DEEP_FETCH_LIMIT=40
# 报告写盘后的完整帖增值：爬取每条帖的完整正文(OP+回复, 经 t/{id}.json + 登录 cookie/浏览器 CDP)
# 并把附件(图片/PDF等)下载到 vault <date>/linuxdo-posts + linuxdo-attachments，辅助资料以
# <details>折叠嵌入。默认开；无头/定时任务没开 9222 浏览器或想要轻量时可关。
# LINUXDO_FULL_POSTS=true
# LINUXDO_DOWNLOAD_ATTACHMENTS=true
# 完整帖上限(默认 40,≈当日池)；单帖附件数量/总字节/单文件大小安全阀
# (默认 20 个 / 20MB；单文件超过 byte 上限会被整体拒绝不写盘,避免一个 500MB 文件
# 撑爆内存——见 LINUXDO_ATTACH_MAX_BYTES_PER_POST)。
# 同日重跑会复用已下载的附件文件(按 <date>/linuxdo-attachments/<帖id>/ 同名文件跳过下载)。
# LINUXDO_FULL_POSTS_LIMIT=40
# LINUXDO_ATTACH_MAX_PER_POST=20
# LINUXDO_ATTACH_MAX_BYTES_PER_POST=20971520
# 整套完整帖增强(爬正文+下附件)的墙钟预算。超时停止调度新的主题但保留已完成的,
# 返回部分结果并照常链接写盘(半成品不再孤儿)——不阻塞报告/海报；0=不设上限。
# 默认 120000(2 分钟)。
# LINUXDO_ENRICH_BUDGET_MS=120000

# --- nodeseek.com 社区 AI 来源（ai-news.mjs + nodeseek.mjs）---
# 默认开启：抓取首页 + /page-2 最新帖，过滤 AI 相关标题并丢弃 VPS/交易噪声。
# 与 linux.do / v2ex 一样仅作数据多样性，不标注、不优先、不写进简报。
# NODESEEK_ENABLED=false
# 列表页，逗号分隔；默认 https://www.nodeseek.com/,https://www.nodeseek.com/page-2
# NODESEEK_LIST_URLS=
# 最多纳入多少条 AI 相关帖（标题过滤后），默认 6
# NODESEEK_TOPIC_LIMIT=6
# 是否深抓帖子正文做 snippet，默认 true；关掉则只用标题
# NODESEEK_DEEP_FETCH=true
# 深抓帖子数量上限（≤ TOPIC_LIMIT），默认 3
# NODESEEK_DEEP_FETCH_LIMIT=3

# --- v2ex.com /go/openai 社区资讯来源（可选）---
# 默认开启：抓取 OpenAI/人工智能节点，过滤 AI 相关标题。
# 与 linux.do / nodeseek 一样仅作数据多样性，不标注、不写进简报。
# V2EX_ENABLED=false
# 列表页，逗号分隔；默认 https://www.v2ex.com/go/openai
# V2EX_LIST_URLS=
# 最多纳入多少条 AI 相关帖（标题过滤后），默认 6
# V2EX_TOPIC_LIMIT=6
# 是否深抓帖子正文做 snippet，默认 true；关掉则只用标题
# V2EX_DEEP_FETCH=true
# 深抓帖子数量上限（≤ TOPIC_LIMIT），默认 3
# V2EX_DEEP_FETCH_LIMIT=3

# --- GitHub 日报海报生图 (image-gen.mjs) ---
# 生图网关 base + key。留空则复用上面 GROK_API_URL/GROK_API_KEY（CPA 同一个 /v1 暴露 gpt-image-2）。
# IMAGE_API_URL=https://cpa.mangoqwq.com/v1
# IMAGE_API_KEY=replace-me
# 海报提示词与参考图在 Obsidian vault 内（用户维护）；留空走内置默认路径。
# IMAGE_PROMPT_FILE=…/Note/AI/AI 提示词/图片生成提示词/GitHub 日报海报提示词.md
# IMAGE_REF_IMAGE=…/OneNode/assersts/Pasted image 20260730051155.png
# 留空则根据当前用户 home 推导默认路径；换机、CI 或生产环境建议显式配置。
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1024
# /images/* 网关偶发 524（约 126s），重试 + 退到 /images/generations 兜底；这是单次请求的墙钟预算。
# IMAGE_TIMEOUT_MS=180000
# IMAGE_RETRIES=2
# IMAGE_SIPS_TIMEOUT_MS=15000  # macOS sips 参考图缩放超时；超时后回退原图
# IMAGE_ENABLED=false  # 设为 false 可整体跳过生图（断网/只跑文字时）
# AI_IMAGE_ENABLED=true  # 默认跟随 IMAGE_ENABLED；可单独关闭 AI 日报海报
# AI_IMAGE_PROMPT_FILE=…/Note/AI/AI 提示词/图片生成提示词/AI 日报海报提示词.md
# AI_IMAGE_REF_IMAGE=…/OneNode/assersts/Pasted image 20260730051155.png  # 默认复用 IMAGE_REF_IMAGE
