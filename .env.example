# --- grok-search backend (required) ---
# Responses-compatible base URL + key. Same values grok-search reads.
GROK_API_URL=https://api.x.ai/v1
GROK_API_KEY=replace-me

# --- extra source providers (optional, improves source coverage) ---
# TAVILY_API_KEY=
# FIRECRAWL_API_URL=

# --- where grok-search skill lives on disk ---
# 留空则默认使用当前用户的 ~/.claude/skills/grok-search。
# 换机、CI 或生产环境建议显式配置。
# GROK_SEARCH_DIR=

# --- where the daily Markdown lands (Obsidian vault) ---
# 留空则根据当前用户 home 推导常见 iCloud Obsidian 路径。
# 换机、CI 或生产环境建议显式配置。
# OBSIDIAN_DIR=

# --- report tuning ---
# Restrict extra sources to the last N days (grok-search --days). 2 = 日报只取近 1-2 天。
GROK_DAYS=2
# How many Tavily/Firecrawl/Fathom sources to pull (grok-search --extra).
GROK_EXTRA=10
# Max chars to fetch from github.com/trending.
GROK_FETCH_MAX_CHARS=80000

# --- model + synthesis (llm-synthesize.mjs) ---
# GROK_MODEL governs BOTH the grok-search /responses search call AND the
# llm-synthesize /chat/completions synthesis call. If you want them independent,
# currently you'd split GROK_SEARCH_MODEL / SYNTH_MODEL in src/config.mjs.
GROK_MODEL=grok-4.5
# Synthesis tuning (optional; defaults shown):
# GROK_SYNTH_MAX_TOKENS=4000   # completion token cap; truncation is detected via finish_reason
# GROK_SYNTH_TIMEOUT_MS=90000  # wall-clock budget for the /chat/completions call
# GROK_CHILD_TIMEOUT_MS=120000 # wall-clock budget for each grok-search child process

# --- query templates ({date} is replaced with today's YYYY-MM-DD) ---
AI_QUERY=今天{date}最新的AI资讯和大模型动态

# --- 第二 AI 通道（完整双通道，ai-news.mjs + run.mjs）---
# 默认开启：与主 AI 通道并存，各自独立搜索+综合，写独立文件 <date>/AI-<slug>.md。
# 写作模型经 /chat/completions 综合（原生 web_search 对非 Grok 模型不可用，已实测）。
# AI_ALT_CHANNEL=false  # 关闭后恢复单通道
# AI_ALT_MODEL=gpt-5.6-luna  # 默认 gpt-5.6-luna；可选 deepseek-v4-pro / grok-4.5 / gpt-5.6-luna
#                          # （deepseek-v4-pro 在部分网关时段配额耗尽/慢，实测会降级；可随时换回）
# AI_ALT_QUERY=        # 留空复用 AI_QUERY
# AI_ALT_FILE=         # 输出文件名覆盖（如 AI-Luna.md）；默认 AI-<模型slug>.md
# AI_ALT_SYNTH_TIMEOUT_MS=300000  # alt 写作模型综合预算（deepseek 实测偏慢），默认 5 分钟

# --- linux.do 论坛 AI 来源优先（ai-news.mjs + linuxdo.mjs）---
# 默认开启：额外抓取 前沿快讯 + 人工智能 tag，合并到综合来源最前面。
# LINUXDO_ENABLED=false
# 列表页，逗号分隔；默认 https://linux.do/c/news/34,https://linux.do/tag/444-tag/444
# LINUXDO_LIST_URLS=
# 最多纳入多少条 AI 相关帖（标题过滤后，HTML 列表路径），默认 8
# LINUXDO_TOPIC_LIMIT=8
# 是否深抓帖子正文做 snippet，默认 true；关掉则只用标题
# LINUXDO_DEEP_FETCH=true
# 深抓帖子数量上限（≤ TOPIC_LIMIT），默认 5
# LINUXDO_DEEP_FETCH_LIMIT=5
# 综合时总来源上限（社区优先占位后补通用来源），默认 18
# AI_SOURCE_MAX_TOTAL=18
# 用 Discourse JSON API 抓 前沿快讯(c/news/34)：不筛 AI、抓当日全部帖子（created_at 精确过滤），
# 供模型完整分析。默认 true；false 则退回原来的 HTML 列表 + AI 标题过滤路径。
# LINUXDO_NEWS34_JSON_API=true
# linux.do 单独进入综合的来源上限（独立于 AI_SOURCE_MAX_TOTAL，社区+通用来源仍共享其预算），
# 默认 50 —— 让当日全部帖子都能喂给模型，而不会挤掉通用来源配额。设 0 回到单池旧行为。
# LINUXDO_MAX_SOURCES=50
# JSON API 全量路径下，深抓正文做 snippet 的帖子数上限（默认 12；独立于 LINUXDO_TOPIC_LIMIT，
# 后者只作用于 HTML 列表路径）。提高则更多帖子有真实正文（模型分析更充分），降低则跑得更快。
# LINUXDO_NEWS34_DEEP_FETCH_LIMIT=12

# --- nodeseek.com 社区 AI 来源（ai-news.mjs + nodeseek.mjs）---
# 默认开启：抓取首页 + /page-2 最新帖，过滤 AI 相关标题并丢弃 VPS/交易噪声。
# 与 linux.do / v2ex 一样仅作数据多样性，不标注、不优先、不写进简报。
# NODESEEK_ENABLED=false
# 列表页，逗号分隔；默认 https://www.nodeseek.com/,https://www.nodeseek.com/page-2
# NODESEEK_LIST_URLS=
# 最多纳入多少条 AI 相关帖（标题过滤后），默认 6
# NODESEEK_TOPIC_LIMIT=6
# 是否深抓帖子正文做 snippet，默认 true；关掉则只用标题
# NODESEEK_DEEP_FETCH=true
# 深抓帖子数量上限（≤ TOPIC_LIMIT），默认 3
# NODESEEK_DEEP_FETCH_LIMIT=3

# --- v2ex.com /go/openai 社区资讯来源（可选）---
# 默认开启：抓取 OpenAI/人工智能节点，过滤 AI 相关标题。
# 与 linux.do / nodeseek 一样仅作数据多样性，不标注、不写进简报。
# V2EX_ENABLED=false
# 列表页，逗号分隔；默认 https://www.v2ex.com/go/openai
# V2EX_LIST_URLS=
# 最多纳入多少条 AI 相关帖（标题过滤后），默认 6
# V2EX_TOPIC_LIMIT=6
# 是否深抓帖子正文做 snippet，默认 true；关掉则只用标题
# V2EX_DEEP_FETCH=true
# 深抓帖子数量上限（≤ TOPIC_LIMIT），默认 3
# V2EX_DEEP_FETCH_LIMIT=3

# --- GitHub 日报海报生图 (image-gen.mjs) ---
# 生图网关 base + key。留空则复用上面 GROK_API_URL/GROK_API_KEY（CPA 同一个 /v1 暴露 gpt-image-2）。
# IMAGE_API_URL=https://cpa.mangoqwq.com/v1
# IMAGE_API_KEY=replace-me
# 海报提示词与参考图在 Obsidian vault 内（用户维护）；留空走内置默认路径。
# IMAGE_PROMPT_FILE=…/Note/AI/AI 提示词/图片生成提示词/GitHub 日报海报提示词.md
# IMAGE_REF_IMAGE=…/OneNode/assersts/Pasted image 20260730051155.png
# 留空则根据当前用户 home 推导默认路径；换机、CI 或生产环境建议显式配置。
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1024
# /images/* 网关偶发 524（约 126s），重试 + 退到 /images/generations 兜底；这是单次请求的墙钟预算。
# IMAGE_TIMEOUT_MS=180000
# IMAGE_RETRIES=2
# IMAGE_SIPS_TIMEOUT_MS=15000  # macOS sips 参考图缩放超时；超时后回退原图
# IMAGE_ENABLED=false  # 设为 false 可整体跳过生图（断网/只跑文字时）
# AI_IMAGE_ENABLED=true  # 默认跟随 IMAGE_ENABLED；可单独关闭 AI 日报海报
# AI_IMAGE_PROMPT_FILE=…/Note/AI/AI 提示词/图片生成提示词/AI 日报海报提示词.md
# AI_IMAGE_REF_IMAGE=…/OneNode/assersts/Pasted image 20260730051155.png  # 默认复用 IMAGE_REF_IMAGE
